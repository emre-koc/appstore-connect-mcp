# Copy this file to ~/.config/appstore-connect-mcp/env and chmod 600 that copy.
# Never put real values in this repository.
ASC_KEY_ID=YOUR_KEY_ID
ASC_ISSUER_ID=YOUR_ISSUER_ID
# Must be an absolute path. Do not use ~ because dotenv files do not expand it.
ASC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8

# Comma-separated App Store Connect app resource IDs. Strongly recommended for reads;
# mandatory when mutations are enabled.
ASC_ALLOWED_APP_IDS=

# Keep false except during a planned, reviewed mutation session.
ASC_ENABLE_MUTATIONS=false

# Optional for future sales/finance report tools.
ASC_VENDOR_NUMBER=
